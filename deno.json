{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env main.ts serve",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env main.ts serve",
    "drop": "deno run --allow-net --allow-read --allow-env src/cli.ts",
    "test": "deno test --allow-read --allow-write",
    "check": "deno fmt --check && deno lint && deno check main.ts src/cli.ts src/redeem.js"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.7",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/cli": "jsr:@std/cli@^1"
  },
  "compilerOptions": {
    "checkJs": true
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["test/vectors.json"]
  }
}
